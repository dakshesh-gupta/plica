# ---- Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
# Any model your key can access. Flash-Lite models usually have the roomiest free limits.
GEMINI_MODEL=gemini-2.5-flash
# Client-side throttle so you stay under the free-tier requests-per-minute cap.
GEMINI_RPM=8
GEMINI_TIMEOUT=45
# If Gemini is missing/failing, answer with a labelled stub so the demo never breaks.
GEMINI_FALLBACK_STUB=true
# Ask Gemini which memories are relevant (sends non-sensitive memory text to Google).
# false = fully local keyword + topic matching.
RECALL_SEMANTIC=true
# Let the Coach ask Gemini for deeper vagueness / conflict checks (?deep=true).
COACH_DEEP=true

# ---- Storage / crypto ----
DATABASE_PATH=./data/plica.db
# base64 of 32 random bytes. Leave empty to auto-generate into ./data/master.key
MASTER_KEY=
SESSION_TTL_HOURS=168

# ---- Optional: real IPFS pinning for receipts ----
PINATA_JWT=

# ---- Server ----
CORS_ORIGINS=*
UNUSED_AFTER_DAYS=7
